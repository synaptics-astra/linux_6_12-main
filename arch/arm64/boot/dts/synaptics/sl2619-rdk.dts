/dts-v1/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/linux-event-codes.h>

#include "sl261x.dtsi"

/ {
	model = "Synaptics SL2619 RDK";
	compatible = "syna,sl2619-rdk", "syna,sl2619";

	cpus {
		cpu@0 {
			cpu0-supply = <&vcore>;
		};
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory {
		device_type = "memory";
		reg = <0x0 0x01000000 0x0 0xdf000000>,
		      <0x1 0xe0000000 0x0 0x20000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reg = <0x00 0x5c000000 0x00 0x20000000>;
			linux,cma-default;
			reusable;
		};
	};

	dmabuf_heap {
		compatible = "syna,berlin-heaps";
		pool-num = <2>;
		reg-names = "NonSecure-NC", "Secure";
		reg = <0 0x7f000000 0 0x00800000>,
		      <0 0x7f800000 0 0x00800000>;
		attributes-num-per-pool = <2>;
		pool-attributes = <0x00000105 0x00000F3A 0x00000102 0x00000F3D>;
	};

	sdhci1_pwrseq: sdhci1-pwrseq {
		compatible = "mmc-pwrseq-simple";
		reset-gpios = <&expander1 2 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <50>;
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		vmmc_sdhci1: vmmc_sdhci1 {
			compatible = "regulator-fixed";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			regulator-name = "vmmc_sdio";
			enable-active-high;
			regulator-boot-on;
			gpio = <&expander1 7 GPIO_ACTIVE_HIGH>;
		};

		vqmmc_sdhci1: vqmmc_sdhci1 {
			compatible = "regulator-gpio";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
			regulator-name = "vqmmc_sdio";
			regulator-type = "voltage";
			enable-active-high;
			gpios = <&expander0 0 GPIO_ACTIVE_HIGH>;
			states = <1800000 0x0
				  3300000 0x1>;
		};

		reg_usb0_vbus: usb0_vbus {
			compatible = "regulator-fixed";
			regulator-name = "usb0_vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			gpio = <&expander0 5 GPIO_ACTIVE_HIGH>;
			enable-active-high;
		};
	};

	mdio-demux {
		compatible = "mdio-demux";
		mux-controls = <&mux1 0>;
		mdio-parent-bus = <&mdio1>;
		#address-cells = <1>;
		#size-cells = <0>;

		mdio@1 {
			reg = <0x1>;
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet_phy0: ethernet-phy@2 {
				compatible = "ethernet-phy-id001c.c916";
				reg = <2>;
				pinctrl-0 = <&eth1_phy_rst_pmux>;
				pinctrl-names = "default";
				realtek,clkout-disable;
				realtek,rxc-ssc-enable;
				realtek,sysclk-ssc-enable;
				reset-assert-us = <20000>;
				reset-deassert-us = <100000>;
				reset-gpios = <&portf 3 GPIO_ACTIVE_HIGH>;
			};
		};
	};

	bt_reg_on: bt_reg_on {
		compatible = "syna,rfkill";
		bt-power-gpio = <&expander1 5 GPIO_ACTIVE_HIGH>;
	};

	bluesleep: bluesleep {
		compatible = "syna,bluesleep";
		bt-dev-wake-gpio = <&expander1 3 GPIO_ACTIVE_HIGH>;
	};
};

&pinctrl {
	eth_mdio_pmux: eth-mdio-pmux {
		groups = "GPIO31", "GPIO32";
		function = "rgmii";
		drive-strength = <3>;
	};

	eth1_pmux: eth1-pmux {
		groups = "GPIO48", "GPIO49", "GPIO50", "GPIO51", "GPIO52", "GPIO53", "GPIO54", "GPIO55", "GPIO56", "GPIO57", "GPIO58", "GPIO59";
		function = "rgmii2";
		drive-strength = <3>;
	};

	sdhci2_pmux: sdhci2-pmux {
		groups = "GPIO16", "GPIO17", "GPIO18", "GPIO19", "GPIO20", "GPIO21", "GPIO22";
		function = "sdio2";
		drive-strength = <7>;
	};

	i2s1_pmux: i2s1-pmux {
		groups = "GPIO0", "GPIO1", "GPIO2", "GPIO3", "GPIO4";
		function = "i2s1";
	};

	i2s2_pmux: i2s2-pmux {
		groups = "GPIO5", "GPIO6", "GPIO7", "GPIO8", "GPIO11";
		function = "i2s2";
	};

	i2s3_pmux: i2s3-pmux {
		groups = "GPIO12", "GPIO13", "GPIO14", "GPIO15";
		function = "i2s3";
	};

	i2c2_pmux: i2c2-pmux {
		groups = "GPIO23", "GPIO24";
		function = "tw2";
		drive-strength = <7>;
	};
};

&sm_pinctrl {
	eth1_phy_rst_pmux: eth1_phy_rst-pmux {
		groups = "SM_GPIO35";
		function = "gpio";
	};

	i2c0_pmux: i2c0-pmux {
		groups = "SM_GPIO12", "SM_GPIO13";
		function = "tw0";
		drive-strength = <7>;
	};

	i2c1_pmux: i2c1-pmux {
		groups = "SM_GPIO3", "SM_GPIO4";
		function = "tw1";
		drive-strength = <7>;
	};

	vcore_gpio_pmux: vcore-gpio-pmux {
		groups = "SM_GPIO5";
		function = "gpio";
	};

	uart1_pmux: uart1-pmux {
		groups = "SM_GPIO7", "SM_GPIO8", "SM_GPIO14", "SM_GPIO15";
		function = "uart1";
		drive-strength = <7>;
	};

	xspi0_pmux: xspi0-pmux {
		groups = "SM_GPIO18", "SM_GPIO19", "SM_GPIO20", "SM_GPIO21", "SM_GPIO22", "SM_GPIO23", "SM_GPIO24",
			 "SM_GPIO25","SM_GPIO26", "SM_GPIO27", "SM_GPIO28", "SM_GPIO29", "SM_GPIO30";
		function = "xspi";
		drive-strength = <7>;
	};
};

&mux1 {
	status = "okay";
};

&pdma0 {
	status = "okay";
};

&sdhci0 {
	status = "okay";
	sdclkdl-dc = /bits/ 8 <20>;
	pad-sp = /bits/ 8 <10>;
	pad-sn = /bits/ 8 <10>;
	mmc-ddr-1_8v;
	mmc-hs200-1_8v;
	mmc-hs400-1_8v;
};

&sdhci1 {
	status = "okay";
	bus-width = <4>;
	sdclkdl-dc = /bits/ 8 <50>;
	pad-sp = /bits/ 8 <12>;
	pad-sn = /bits/ 8 <12>;
	no-sd;
	no-mmc;
	non-removable;
	mmc-pwrseq = <&sdhci1_pwrseq>;
	mode1-tune;
	keep-power-in-suspend;
};

&sdhci2 {
	pinctrl-0 = <&sdhci2_pmux>;
	pinctrl-names = "default";
	bus-width = <4>;
	no-sdio;
	no-mmc;
	disable-wp;
	sdclkdl-dc = /bits/ 8 <50>;
	pad-sp = /bits/ 8 <12>;
	pad-sn = /bits/ 8 <12>;
	vmmc-supply = <&vmmc_sdhci1>;
	vqmmc-supply = <&vqmmc_sdhci1>;
};

&uart0 {
	status = "okay";
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pmux>;
	clock-frequency = <100000>;
	no-irq-suspend;
	clock-frequency = <100000>;

	expander0: gpio@43 {
		compatible = "fcs,fxl6408";
		reg = <0x43>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	expander1: gpio@44 {
		compatible = "fcs,fxl6408";
		reg = <0x44>;
		gpio-controller;
		#gpio-cells = <2>;
	};

	ina220@40 {
		compatible = "ti,ina220";
		reg = <0x40>;
	};

	ina220@41 {
		compatible = "ti,ina220";
		reg = <0x41>;
	};

	cam_node: ov5647@36 {
		compatible = "ovti,ov5647";
		reg = <0x36>;
		status = "okay";

		pwdn-gpios = <&expander1 4 GPIO_ACTIVE_LOW>;
		clocks = <&osc>;

		rotation = <0>;
		orientation = <2>;

		port {
			cam_endpoint: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				remote-endpoint = <&csi_input>;
			};
		};
	};
};

&i2c1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c1_pmux>;

	vcore: regulator@60 {
		compatible = "silergy,sy8827n";
		regulator-name = "vcore";
		regulator-min-microvolt = <700000>;
		regulator-max-microvolt = <987500>;
		regulator-always-on;
		regulator-boot-on;
		regulator-active-discharge = <0>;
		pinctrl-names = "default";
		pinctrl-0 = <&vcore_gpio_pmux>;
		enable-gpios = <&portc 5 GPIO_ACTIVE_LOW>;
		silergy,vsel-step = <1>;
		reg = <0x60>;
	};
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pmux>;
};

&ethernet1 {
	status = "okay";
	pinctrl-0 = <&eth_mdio_pmux>, <&eth1_pmux>;
	pinctrl-names = "default";
	phy-handle = <&ethernet_phy0>;
	phy-mode = "rgmii-id";

	mdio1: mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&usb0 {
	status = "okay";
	dr_mode = "peripheral";
};

&usb_phy0 {
	status = "okay";
};

&usb1 {
	status = "okay";
	dr_mode = "host";
};

&usb_phy1{
	status = "okay";
};

&uart1 {
	status = "okay";
	pinctrl-0 = <&uart1_pmux>;
	pinctrl-names = "default";
};

&gpu {
	status = "okay";
};

&xspi0 {
	status = "disabled";
	pinctrl-0 = <&xspi0_pmux>;
	pinctrl-names = "default";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0>;
		status = "okay";
	};
};

&klamath_pcm {
	status = "okay";
};

&i2s1_dai {
	status = "okay";
	pinctrl-0 = <&i2s1_pmux>;
	pinctrl-names = "default";
	clk_src = "APLL";
	clk_feed = "I2S1_DI";
	output-mclk;
};

&i2s2_dai {
	status = "okay";
	pinctrl-0 = <&i2s2_pmux>;
	pinctrl-names = "default";
	clk_src = "APLL";
	clk_feed = "I2S3_DI";
};

&i2s3_dai {
	status = "okay";
	pinctrl-0 = <&i2s3_pmux>;
	pinctrl-names = "default";
	clk_src = "APLL";
	clk_feed = "I2S3_DI";
};

&klamath_asoc {
	status = "okay";

	asoc_i2s1: asoc-i2s1 {
		status = "okay";
		stream-name = "asoc-i2s1";
		link-name = "asoc-i2s1";
		format = "i2s";
		bitclock-master;
		frame-master;
		cpu-node = <&i2s1_dai>;
		codec-name = "snd-soc-dummy";
		codec-dai-name = "snd-soc-dummy-dai";
		platform-node = <&klamath_pcm>;
	};

	asoc_i2s2: asoc-i2s2 {
		status = "okay";
		stream-name = "asoc-i2s2";
		link-name = "asoc-i2s2";
		format = "i2s";
		bitclock-master;
		frame-master;
		cpu-node = <&i2s2_dai>;
		codec-name = "snd-soc-dummy";
		codec-dai-name = "snd-soc-dummy-dai";
		platform-node = <&klamath_pcm>;
	};

	asoc_i2s3: asoc-i2s3 {
		status = "okay";
		stream-name = "asoc-i2s3";
		link-name = "asoc-i2s3";
		format = "i2s";
		bitclock-master;
		frame-master;
		cpu-node = <&i2s3_dai>;
		codec-name = "snd-soc-dummy";
		codec-dai-name = "snd-soc-dummy-dai";
		platform-node = <&klamath_pcm>;
	};
};

&avio {
	status = "okay";
};

&vpp {
	status = "okay";
	enable_ampless_boot = <1>;
};

&drm {
	status = "okay";

	dsi_panel {
		status= "okay";

		ACTIVE_WIDTH = <1920>;
		HFP = <88>;
		HSYNCWIDTH = <44>;
		HBP = <148>;
		ACTIVE_HEIGHT = <1080>;
		VFP = <4>;
		VSYNCWIDTH = <5>;
		VBP = <36>;
		FREQ = <148500>;
		bits_per_pixel = <24>;
		busformat = <0>;

		HTOTAL = <2200>;
		Lanes = /bits/ 8 <4>;
		Vid_mode = /bits/ 8 <2>;
		virtual_chan = /bits/ 8 <0>;
		Clk_Lane_Polarity = /bits/ 8 <0>;
		Data_Lane_Polarity = /bits/ 8 <0>;
		Recv_ack = /bits/ 8 <0>;
		Loosely_18 = /bits/ 8 <0>;
		H_polarity = /bits/ 8 <1>;
		V_Polarity = /bits/ 8 <1>;
		Data_Polarity = /bits/ 8 <1>;
		Eotp_tx = /bits/ 8 <1>;
		Eotp_rx = /bits/ 8 <0>;
		non-Continuous_clk = /bits/ 8 <0>;
		dpi_lp_cmd = /bits/ 8 <1>;
		Color_coding = /bits/ 8 <5>;
		Chunks = <0>;
		Null_Pkt = <0>;
		Byte_clk = <148500>;

		/*  COMMAND= Command for initialisation
		*  Format - <CMD> <Payloadlength-n> <BYTE1> <...> <BYTEn>
		*  Long write Ex: 39 04 FF 98 81 03

		*  Delay in micro seconds Command format: 0xFF <4BYTE delay>
		*  Delay for 100ms(100000us => 0x000186A0)
		*      - FF A0 86 01 00
		*/
		command = /bits/ 8 <0xFF 0x10 0x27 0x00 0x00>;
		dsi_hdmi_lt9611_bridge {
			compatible = "syna-bridge,lt9611";
			enable-gpio =  <&expander0 1 GPIO_ACTIVE_HIGH>;
			reset-gpio =  <&expander0 7 GPIO_ACTIVE_LOW>;
			i2c_bus = <2>;
		};
	};
};

&camera_video {
	status = "okay";
};

&isp {
	status = "okay";
};

&csi {
	status = "okay";
};
